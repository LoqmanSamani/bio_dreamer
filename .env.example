# BioDreamer — Environment Variables
#
# Copy this file to .env and fill in the values.
# These variables configure the backend server, model storage,
# Hugging Face Hub access, and external service credentials.

# --- Hugging Face Hub ---
HF_TOKEN=your_huggingface_token_here
HF_ORG=biodreamer

# --- Server ---
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
CORS_ORIGINS=http://localhost:3000

# --- Database (job queue / results persistence) ---
DATABASE_URL=sqlite:///./biodreamer.db

# --- Model storage ---
MODEL_CACHE_DIR=./model_cache
CHECKPOINT_DIR=./checkpoints

# --- External oracles ---
ESMFOLD_ENDPOINT=
ALPHAFOLD_DB_PATH=

# --- Logging & Monitoring ---
WANDB_PROJECT=biodreamer
LOG_LEVEL=INFO
